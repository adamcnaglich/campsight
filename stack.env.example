# Portainer stack variables for CampSight.
# Copy to stack.env and fill in, then "Load variables from .env file" in Portainer.

# Required
NOTIFY_EMAIL=you@example.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RIDB_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional
RESEND_FROM_EMAIL=CampSight <onboarding@resend.dev>
GOOGLE_MAPS_API_KEY=
HOME_REGION=Michigan
CHECK_INTERVAL=*/15 * * * *
CAMPSIGHT_PORT=3333
LOG_LEVEL=info
