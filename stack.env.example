# Portainer stack variables for CampSight.
# Copy to stack.env and fill in, then "Load variables from .env file" in Portainer.

# Required
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-long-password
SMTP_HOST=smtp.mail.me.com
SMTP_USER=you@icloud.com
SMTP_PASS=app-specific-password
RIDB_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional
PUBLIC_URL=
CAMPSIGHT_DATA=
SMTP_PORT=587
SMTP_FROM=CampSight <you@icloud.com>
SMTP_SECURE=
GOOGLE_MAPS_API_KEY=
HOME_REGION=Michigan
CHECK_INTERVAL=*/15 * * * *
CAMPSIGHT_PORT=3333
LOG_LEVEL=info
