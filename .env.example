# Local development only (`npx nx serve api` + `npx nx serve web`).
# The Portainer stack sets these as stack variables instead — see stack.env.example.

# ─── Required ───────────────────────────────────────────────────────────────

# Where availability alerts are sent
NOTIFY_EMAIL=

# Resend email API — https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=CampSight <onboarding@resend.dev>

# RIDB API key (recreation.gov) — https://ridb.recreation.gov
RIDB_API_KEY=

# ─── Optional ───────────────────────────────────────────────────────────────

# Google Maps JavaScript API key for the campsite map (list view works without it)
GOOGLE_MAPS_API_KEY=

# State used for the "available near you" strip
HOME_REGION=Michigan

# SQLite database path (container default: /data/campsight.db)
DATABASE_PATH=./data/campsight.db

# Scheduler interval (cron expression, default: every 15 minutes)
CHECK_INTERVAL=*/15 * * * *

# Delay between availability requests during scheduler checks (milliseconds)
SCHEDULER_REQUEST_DELAY_MS=1000

# Maximum grouped campsite checks per cycle. Set 0 for no cap.
SCHEDULER_MAX_GROUPS_PER_CYCLE=0

# Cooldown after a 429 rate-limit response before next cycle attempts (milliseconds)
SCHEDULER_RATE_LIMIT_COOLDOWN_MS=300000

# Consecutive unavailable checks before a notified date may alert again
SCHEDULER_NOTIFY_CLEAR_AFTER_MISSES=3

# Availability request retry tuning
AVAILABILITY_MAX_RETRIES=3
AVAILABILITY_REQUEST_TIMEOUT_MS=15000
AVAILABILITY_BACKOFF_BASE_MS=1000
AVAILABILITY_BACKOFF_MAX_MS=30000

# Logging (pino) — level: debug | info | warn | error | fatal
# Defaults to "debug" in development, "info" in production
LOG_LEVEL=debug

# API port
PORT=3333

# Vite dev server origin, for CORS during `nx serve web` (unused in the container)
CORS_ORIGIN=http://localhost:4200
