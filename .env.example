# ─── Backend (apps/api) ─────────────────────────────────────────────────────

# Firebase Admin — paste the full service account JSON on one line (no wrapping quotes needed)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...",...}

# Resend email API
RESEND_API_KEY=
RESEND_FROM_EMAIL=CampSight <noreply@yourdomain.com>

# RIDB API key (recreation.gov) — get one at https://ridb.recreation.gov
RIDB_API_KEY=

# SQLite database path (Railway: use the mounted volume path, e.g. /data/campsight.db)
DATABASE_PATH=./data/campsight.db

# CORS origin (your frontend URL)
CORS_ORIGIN=http://localhost:4200

# Scheduler interval (cron expression, default: every 15 minutes)
CHECK_INTERVAL=*/15 * * * *

# Delay between availability requests during scheduler checks (milliseconds)
SCHEDULER_REQUEST_DELAY_MS=1000

# Maximum grouped campsite checks per cycle. Set 0 for no cap.
SCHEDULER_MAX_GROUPS_PER_CYCLE=0

# Cooldown after a 429 rate-limit response before next cycle attempts (milliseconds)
SCHEDULER_RATE_LIMIT_COOLDOWN_MS=300000

# Availability request retry tuning
AVAILABILITY_MAX_RETRIES=3
AVAILABILITY_REQUEST_TIMEOUT_MS=15000
AVAILABILITY_BACKOFF_BASE_MS=1000
AVAILABILITY_BACKOFF_MAX_MS=30000

# Logging (pino) — level: debug | info | warn | error | fatal
# Defaults to "debug" in development, "info" in production
LOG_LEVEL=debug

# Port
PORT=3333

# Comma-separated list of allowed admin emails.
# Only these Google accounts can access the admin panel.
ADMIN_ALLOWED_EMAILS=

# Where to send "access request" emails (defaults to first ADMIN_ALLOWED_EMAILS if unset)
ADMIN_NOTIFY_EMAIL=

# Public API URL for the approve link in emails (e.g. https://api.campsight.app).
# Redirect after approval uses CORS_ORIGIN (frontend URL).
API_PUBLIC_URL=

# ─── Frontend (apps/web) ───────────────────────────────────────────────────

VITE_API_URL=http://localhost:3333
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Maps API key (for campground/campsite map views)
VITE_GOOGLE_MAPS_API_KEY=

# Comma-separated list of allowed admin emails (must match backend ADMIN_ALLOWED_EMAILS)
VITE_ADMIN_ALLOWED_EMAILS=
